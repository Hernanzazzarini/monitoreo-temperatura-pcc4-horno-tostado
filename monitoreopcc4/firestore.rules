rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }
    function rol() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function esAdmin() {
      return autenticado() && rol() == 'admin';
    }
    function generaLotes() {
      return autenticado() && rol() in ['admin', 'encargada'];
    }

    match /users/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // Cola de lotes. Los lotes son únicos: el código es el id del documento, "create" solo
    // aplica si no existe y nadie puede cambiar el código de uno existente.
    // Encargada/admin los generan, editan (observación) y quitan; el personal solo embolsa y cierra.
    match /lotes/{codigo} {
      allow read: if autenticado();
      allow create: if generaLotes() && request.resource.data.codigo == codigo;
      allow delete: if generaLotes();
      allow update: if request.resource.data.codigo == resource.data.codigo && (
        generaLotes() ||
        (autenticado() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['unidades', 'estado', 'inicio', 'fin', 'respaldado', 'cerradoPor', 'materiaPrima']))
      );
    }

    // Envases cargados en la tolva: no se modifican ni se borran
    match /inyecciones/{id} {
      allow read, create: if autenticado();
    }
  }
}
