rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }
    function rol() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function esAdmin() {
      return autenticado() && rol() == 'admin';
    }
    function generaLotes() {
      return autenticado() && rol() in ['admin', 'encargada'];
    }

    match /users/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // Cola de lotes: encargada/admin los generan y quitan; cualquier usuario embolsa y cierra
    match /lotes/{codigo} {
      allow read: if autenticado();
      allow create, delete: if generaLotes();
      allow update: if autenticado();
    }

    // Envases cargados en la tolva: no se modifican ni se borran
    match /inyecciones/{id} {
      allow read, create: if autenticado();
    }
  }
}
